{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Front matter documentaire Guide IA GameDev",
  "type": "object",
  "required": ["title", "id", "status", "version", "lang", "usage-context-standard"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "status": {"enum": ["planned", "draft", "in-progress", "review", "validated", "reviewed", "published", "deprecated", "archived", "complete"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "lang": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "usage-context-standard": {"const": "DOC-V0-ANN-CONTEXTES"}
  },
  "additionalProperties": true
}
